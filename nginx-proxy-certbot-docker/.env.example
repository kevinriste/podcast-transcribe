# Values docker compose substitutes into docker-compose.yml in this directory.
# Copy to .env (gitignored) and fill in:
#   cp .env.example .env && chmod 600 .env
#
# Compose reads .env from this directory only, and only as plain KEY=value lines, so the
# root .env (which may contain shell commands) can't be linked here. Keep these in sync
# with the root .env. Values are copied into the containers when they are created, so an
# empty value here only shows up the next time `docker compose up` recreates them: the
# proxy would lose its host name and certificate renewal would fail.

# Public host name served by the proxy and covered by the Let's Encrypt certificate
# (VIRTUAL_HOST / LETSENCRYPT_HOST for the podcast_primary service).
PODCAST_DOMAIN_PRIMARY=podcast.example.com

# Contact email for the ACME (Let's Encrypt) account; expiry notices go here.
GMAIL_PRIMARY_ACCOUNT=you@example.com

# Cloudflare credentials for the DNS-01 challenge (acme.sh dns_cf). The token needs
# Zone:DNS:Edit on the zone that serves PODCAST_DOMAIN_PRIMARY.
CF_TOKEN=your-cloudflare-api-token
CF_ACCOUNT_ID=your-cloudflare-account-id
