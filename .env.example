# Machine-specific configuration for the podcast pipeline. Copy to .env
# (gitignored) and fill in real values:  cp .env.example .env
# process.sh and process-caller.sh source this file with `set -a`, so the
# values are exported and Docker Compose picks them up via ${VAR} interpolation.

# --- Gmail intake (imap) ---
GMAIL_PODCAST_ACCOUNT=you@example.com
GMAIL_PODCAST_ACCOUNT_APP_PASSWORD=app-password-here

# --- Gemini (summaries, LLM filter checks, Gemini TTS) ---
GEMINI_API_KEY=your-gemini-key

# --- OpenAI (comment-highlights briefings) ---
OPENAI_API_KEY=your-openai-key
# Optional: override the comment-briefing model (default gpt-5-mini)
# COMMENT_BRIEFING_MODEL=gpt-5-mini

# --- Google Cloud TTS ---
# Absolute path to the service-account JSON on this machine.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# --- Gotify push notifications ---
GOTIFY_SERVER=https://gotify.example.com
GOTIFY_TOKEN=your-gotify-token

# --- Dropcaster feeds ---
PODCAST_DOMAIN_PRIMARY=podcast.example.com
PODCAST_DOMAIN_SECONDARY=podcast-secondary.example.com

# --- nginx-proxy / acme-companion (Cloudflare DNS-01) ---
GMAIL_PRIMARY_ACCOUNT=you@example.com
CF_TOKEN=your-cloudflare-token
CF_ACCOUNT_ID=your-cloudflare-account-id

# --- Runtime ---
# Timezone for log timestamps (any tz database name).
TZ=UTC
# Directory for per-run process logs (process-caller.sh).
LOG_DIR=/var/log/podcast-transcribe
# Retention window for the topical feed, in weeks (default 8). Audio older than
# this is moved out of the feed into ./audio-archive (never deleted). The
# evergreen feed is never archived.
# PODCAST_RETENTION_WEEKS=8
